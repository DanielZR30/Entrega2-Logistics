# ==========================================
# Configuración del Microservicio de Logística (Ejemplo)
# Copia este archivo como .env y ajusta los valores correspondientes
# ==========================================

# Contraseña del contenedor SQL Server
MSSQL_SA_PASSWORD=YourStrongPasswordHere!
MSSQL_PORT=1433

# Parámetros de la Base de Datos
DB_SERVER=localhost,1433
DB_NAME=LogisticsDb
DB_USER=sa
DB_PASSWORD=YourStrongPasswordHere!

# Cadena de conexión directa
DB_CONNECTION_STRING=Server=localhost,1433;Database=LogisticsDb;User Id=sa;Password=YourStrongPasswordHere!;TrustServerCertificate=True;MultipleActiveResultSets=True

# Override para ASP.NET Core Configuration (ConnectionStrings:MyConnection)
ConnectionStrings__MyConnection=Server=localhost,1433;Database=LogisticsDb;User Id=sa;Password=YourStrongPasswordHere!;TrustServerCertificate=True;MultipleActiveResultSets=True
